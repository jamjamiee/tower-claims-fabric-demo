    {
      "name": "Tower Claims Command Centre",
      "id": "77777777-7777-4777-8777-777777777777"
    }
  ],
  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "88888888-8888-4888-8888-888888888888"
      },
      "text": "bronze_claims\n| where timestamp between (_startTime .. _endTime)\n| summarize TotalClaims = count()\n",
      "id": "a1111111-1111-4111-8111-111111111111",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "88888888-8888-4888-8888-888888888888"
      },
      "text": "bronze_claims\n| where timestamp between (_startTime .. _endTime)\n| where status !in (\"Settled\", \"Rejected\")\n| summarize OpenClaims = count()\n",
      "id": "a2222222-2222-4222-8222-222222222222",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "88888888-8888-4888-8888-888888888888"
      },
      "text": "bronze_claims\n| where timestamp between (_startTime .. _endTime)\n| summarize SLARiskClaims = countif(sla_at_risk == true)\n",
      "id": "a3333333-3333-4333-8333-333333333333",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "88888888-8888-4888-8888-888888888888"
      },
      "text": "bronze_claims\n| where timestamp between (_startTime .. _endTime)\n| summarize AvgDaysOpen = round(avg(todouble(days_open)), 1), AvgSettlementDays = round(avg(todouble(days_to_settle)), 1)\n",
      "id": "a4444444-4444-4444-8444-444444444444",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "88888888-8888-4888-8888-888888888888"
      },
      "text": "bronze_claims\n| where timestamp between (_startTime .. _endTime)\n| summarize DigitalLodgementRate = strcat(round(100.0 * countif(digital_lodgement == true) / count(), 1), \"%\")\n",
      "id": "a5555555-5555-4555-8555-555555555555",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "88888888-8888-4888-8888-888888888888"
      },
      "text": "bronze_claims\n| where timestamp between (_startTime .. _endTime)\n| summarize Claims=count(), WeatherClaims=countif(is_weather_event == true), SLARisk=countif(sla_at_risk == true) by bin(timestamp, 5m)\n| order by timestamp asc\n",
      "id": "a6666666-6666-4666-8666-666666666666",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "88888888-8888-4888-8888-888888888888"
      },
      "text": "bronze_claims\n| where timestamp between (_startTime .. _endTime)\n| summarize Claims=count(), SLARisk=countif(sla_at_risk == true) by region\n| order by Claims desc\n",
      "id": "a7777777-7777-4777-8777-777777777777",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "88888888-8888-4888-8888-888888888888"
      },
      "text": "bronze_claims\n| where timestamp between (_startTime .. _endTime)\n| summarize Claims=count() by product\n| order by Claims desc\n",
      "id": "a8888888-8888-4888-8888-888888888888",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "88888888-8888-4888-8888-888888888888"
      },
      "text": "bronze_claims\n| where timestamp between (_startTime .. _endTime)\n| summarize Claims=count() by status\n| order by Claims desc\n",
      "id": "a9999999-9999-4999-8999-999999999999",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "88888888-8888-4888-8888-888888888888"
      },
      "text": "bronze_claims\n| where timestamp between (_startTime .. _endTime)\n| where isnotempty(supplier)\n| summarize Claims=count(), SLARisk=countif(sla_at_risk == true), AvgDaysOpen=round(avg(todouble(days_open)), 1) by supplier\n| top 10 by Claims desc\n",
      "id": "b1111111-1111-4111-8111-111111111111",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "88888888-8888-4888-8888-888888888888"
      },
      "text": "bronze_claims\n| where timestamp between (_startTime .. _endTime)\n| summarize AvgEstimatedCost=round(avg(todouble(estimated_cost)), 2), MaxEstimatedCost=max(todouble(estimated_cost)) by product\n| order by AvgEstimatedCost desc\n",
      "id": "b2222222-2222-4222-8222-222222222222",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    }
  ]
}
