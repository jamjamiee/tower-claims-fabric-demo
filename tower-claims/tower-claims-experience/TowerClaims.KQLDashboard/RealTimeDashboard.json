  "dataSources": [
    {
      "id": "88888888-8888-4888-8888-888888888888",
      "kind": "kusto-trident",
      "scopeId": "kusto-trident",
      "clusterUri": "",
      "database": "00000000-0000-0000-0000-000000000000",
      "name": "TowerClaims",
      "workspace": "00000000-0000-0000-0000-000000000000"
    }
  ],
